# websearch-mcp 环境配置示例
#
# 复制为 .env 后填写。.env 已在 .gitignore 里 —— 绝不会被提交。
# 权限必须 600：chmod 600 .env
#
# ⚠️ 本文件是**示例**，不要在这里填真实凭据（它会进 git）。

# ══════════════ 搜索服务（websearch.server）══════════════

# 监听地址与端口
WS_HOST=0.0.0.0
WS_PORT=8300

# Bearer token 文件（每行一个 token，权限 600）
WS_TOKEN_FILE=/opt/websearch-mcp/.tokens

# 出网代理（配了才能用 Google/DDG/Brave 等墙外源）
# 指向本地 sing-box 起的 HTTP 代理；留空 = 直连（只有国内源）
WS_PROXY=

# 引擎开关（逗号分隔）。配了代理后可把墙外源加回来：
#   WS_ENGINES=bing,so360,weixin,baidu,duckduckgo,brave,bing_intl
# 未配代理时留着墙外源也没关系 —— 它们会超时后被熔断隔离
WS_ENGINES=bing,so360,baidu_m,sogou_m,so360_m,weixin,toutiao,bing_intl,duckduckgo,mojeek,brave,baidu,sogou
WS_DISABLE_ENGINES=

# 预算与并发（手机/低配设备建议保守）
WS_TOTAL_BUDGET_MS=12000
WS_ENGINE_TIMEOUT_MS=6000
WS_CONNECT_TIMEOUT_MS=2500
WS_MAX_CONCURRENCY=24

# 熔断
WS_CB_THRESHOLD=3
WS_CB_COOLDOWN=60
WS_CB_COOLDOWN_MAX=600

# 相关性校验（挡「投毒式反爬」，0 = 关闭）
WS_MIN_RELEVANCE=0.3

# 缓存（只用于防反爬，不是数据源）
WS_CACHE_ENABLED=1
WS_CACHE_DIR=/opt/websearch-mcp/cache
WS_CACHE_SEARCH_TTL=300
WS_CACHE_FETCH_TTL=1800

# ══════════════ 管理面板（websearch.proxy.panel_server）══════════════

# 配置文件路径（含凭据，600 权限，已在 .gitignore）
WS_CONFIG_FILE=/opt/websearch-mcp/.env

# 面板监听地址。
# ⚠️ 默认只回环（只能本机访问）。要从别的机器访问，推荐用 SSH 端口转发：
#     ssh -L 8500:127.0.0.1:8500 user@server
# 改成 0.0.0.0 会让面板对全网可达，请务必确认口令强度并限制来源 IP。
WS_PANEL_HOST=127.0.0.1
WS_PANEL_PORT=8500

# ══════════════ 代理（由面板写入，一般不用手工改）══════════════

# 机场订阅链接（**含 token，切勿提交到 git**）
# 面板里填写更安全（不会出现在 shell 历史里）
WS_SUBSCRIPTION_URL=

# 是否启用代理（1/0）
WS_PROXY_ENABLED=0

# 本地代理端口（sing-box 监听；只绑 127.0.0.1）
WS_HTTP_PROXY_PORT=17890
WS_SOCKS_PROXY_PORT=17891

# 面板启动时自动拉起代理
WS_PROXY_AUTO_START=1

# 后台健康检查间隔（秒）
WS_PROXY_HEALTH_INTERVAL=300

# sing-box 二进制路径
WS_SINGBOX_BIN=/opt/sing-box/sing-box

# sing-box 配置与日志的工作目录（含节点凭据，权限 700）
WS_PROXY_WORKDIR=/opt/websearch-mcp/proxy-run

# 面板口令（首次启动自动生成并打印一次；遗失可删除此行重新生成）
WS_PANEL_TOKEN=
